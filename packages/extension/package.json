{
	"name": "@freedia/extension",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun wxt",
		"build": "bun --bun wxt build",
		"zip": "bun --bun wxt zip",
		"typecheck": "tsc --noEmit",
		"postinstall": "bun --bun wxt prepare",
		"ui:dev": "bun --bun vite --config src/ui/dev/vite.config.ts"
	},
	"dependencies": {
		"hast-util-to-text": "^4.0.2",
		"highlight.js": "^11.11.1",
		"lowlight": "^3.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^21.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/hast": "^3.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@wxt-dev/module-react": "^1.2.2",
		"freedia": "workspace:*",
		"tailwindcss": "^4.3.3",
		"vite": "8.3.4",
		"wxt": "^0.21.4"
	}
}
